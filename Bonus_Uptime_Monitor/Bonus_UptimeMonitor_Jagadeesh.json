{
  "name": "Bonus Uptime Monitor - Jagadeesh",
  "nodes": [
    {
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "every-5-minutes"
    },
    {
      "name": "Ping Demo App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "url": "https://demo.realworld.io",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ping-demo-app",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Status Is 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode || 0 }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "status-is-200?"
    },
    {
      "name": "Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        440
      ],
      "parameters": {
        "jsCode": "const d=$input.first()?.json??{}; return [{json:{text:`Uptime alert: demo.realworld.io did not return HTTP 200. Status: ${d.statusCode??'request failed'}. Inspect the n8n execution.`}}];"
      },
      "id": "build-alert"
    },
    {
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        990,
        440
      ],
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "telegram-alert",
      "credentials": {
        "telegramApi": {
          "id": "SELECT_IN_N8N",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Ping Demo App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Demo App": {
      "main": [
        [
          {
            "node": "Status Is 200?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status Is 200?": {
      "main": [
        [],
        [
          {
            "node": "Build Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Alert": {
      "main": [
        [
          {
            "node": "Telegram Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "tags": []
}