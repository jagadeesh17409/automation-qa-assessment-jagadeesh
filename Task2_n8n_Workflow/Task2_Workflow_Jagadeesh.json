{
  "name": "Task2 GitHub Morning Brief - Jagadeesh",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "github-morning-brief",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "webhookId": "github-morning-brief"
    },
    {
      "name": "GitHub Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "url": "https://api.github.com/search/repositories",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "language:javascript"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "github-search",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Top 5 Repositories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "const raw=$input.first()?.json??{}; const items=raw.items??raw.body?.items??[]; const top=items.sort((a,b)=>(b.stargazers_count??0)-(a.stargazers_count??0)).slice(0,5); if(!top.length) return [{json:{ok:false,full_name:'No repository data',stars:0,html_url:'',description:'GitHub API returned no items; inspect rate limit or request error.'}}]; return top.map((r,i)=>({json:{rank:i+1,full_name:r.full_name,stars:r.stargazers_count,html_url:r.html_url,description:r.description??''}}));"
      },
      "id": "top-5-repositories"
    },
    {
      "name": "Enrich Top Repository",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        700,
        300
      ],
      "parameters": {
        "url": "={{ 'https://api.github.com/repos/' + $json.full_name }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "enrich-top-repository",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Stars At Least 1000?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        940,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.stargazers_count || 0 }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "stars-at-least-1000?"
    },
    {
      "name": "Format High Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        170
      ],
      "parameters": {
        "jsCode": "const r=$input.first()?.json??{}; return [{json:{text:`HIGH PRIORITY GitHub repository\\n${r.full_name??'Unavailable'}\\nStars: ${r.stargazers_count??'n/a'}\\nLanguage: ${r.language??'n/a'}\\n${r.html_url??''}`}}];"
      },
      "id": "format-high-digest"
    },
    {
      "name": "Format Normal Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        430
      ],
      "parameters": {
        "jsCode": "const r=$input.first()?.json??{}; return [{json:{text:`GitHub morning brief\\n${r.full_name??'No repository data'}\\nStars: ${r.stargazers_count??'n/a'}\\nLanguage: ${r.language??'n/a'}\\n${r.html_url??'Inspect GitHub API error/rate limit'}`}}];"
      },
      "id": "format-normal-digest"
    },
    {
      "name": "Telegram High",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1430,
        170
      ],
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "telegram-high",
      "credentials": {
        "telegramApi": {
          "id": "SELECT_IN_N8N",
          "name": "Telegram account"
        }
      }
    },
    {
